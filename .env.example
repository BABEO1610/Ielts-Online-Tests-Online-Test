# AI Assistant Config
# Dùng Google AI Studio / Gemini
# Lấy key tại Google AI Studio rồi điền vào .env thật ở root project.
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
AI_PROVIDER=gemini

# Có thể để AI_MODEL=gemini, backend sẽ map sang gemini-flash-lite-latest.
# Khuyến nghị dùng tên model thật để dễ debug:
AI_MODEL=gemini-flash-lite-latest

# Nếu muốn quay lại OpenAI thì đổi AI_PROVIDER=openai và điền OPENAI_API_KEY.
OPENAI_API_KEY=
